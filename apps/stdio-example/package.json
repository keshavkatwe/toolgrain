{
  "name": "@toolgrain/stdio-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "inspect": "bun scripts/inspect.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@toolgrain/core": "workspace:*",
    "@toolgrain/mcp": "workspace:*",
    "@toolgrain/node": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "vitest": "5.0.4"
  }
}
