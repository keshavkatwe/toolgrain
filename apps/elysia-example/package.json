{
  "name": "@toolgrain/elysia-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --target=bun --outdir=dist src/index.ts",
    "check-types": "tsc --noEmit",
    "start": "bun run dist/index.js",
    "dev": "bun --watch run src/index.ts",
    "test": "vitest run",
    "test:examples": "vitest run",
    "inspect": "bun ../../scripts/inspect-http.mjs http://127.0.0.1:3003/mcp"
  },
  "dependencies": {
    "@toolgrain/core": "workspace:*",
    "@toolgrain/mcp": "workspace:*",
    "zod": "4.6.7",
    "@toolgrain/http": "workspace:*",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "vitest": "5.0.4",
    "@types/bun": "1.3.14"
  }
}
