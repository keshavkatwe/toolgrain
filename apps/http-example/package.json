{
  "name": "@toolgrain/http-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "test:examples": "vitest run",
    "inspect": "bun ../../scripts/inspect-http.mjs http://127.0.0.1:3000/mcp"
  },
  "dependencies": {
    "@toolgrain/core": "workspace:*",
    "@toolgrain/mcp": "workspace:*",
    "@toolgrain/node": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "vitest": "5.0.4",
    "tsx": "4.21.0"
  }
}
