{
  "name": "@toolgrain/fastify-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "start": "fastify start --address 127.0.0.1 dist/app.js",
    "dev": "fastify start --watch --address 127.0.0.1 --port 3004 src/app.ts",
    "test": "vitest run",
    "test:examples": "vitest run"
  },
  "dependencies": {
    "@toolgrain/core": "workspace:*",
    "@toolgrain/mcp": "workspace:*",
    "zod": "4.6.7",
    "@toolgrain/http": "workspace:*",
    "fastify": "5.12.7",
    "fastify-cli": "7.4.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "vitest": "5.0.4"
  }
}
