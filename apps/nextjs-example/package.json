{
  "name": "@toolgrain/nextjs-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check-types": "next typegen && tsc --noEmit",
    "start": "next start --hostname 127.0.0.1",
    "dev": "next dev --hostname 127.0.0.1 --port 3005",
    "test": "vitest run",
    "test:examples": "vitest run",
    "inspect": "bun ../../scripts/inspect-http.mjs http://127.0.0.1:3005/mcp"
  },
  "dependencies": {
    "@toolgrain/core": "workspace:*",
    "@toolgrain/mcp": "workspace:*",
    "zod": "4.6.7",
    "@toolgrain/http": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.0",
    "vitest": "5.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
