{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["reports/**"]
    },
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "test:examples": {
      "dependsOn": ["build"],
      "outputs": ["reports/**"]
    }
  }
}
