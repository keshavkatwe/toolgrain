{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-http-example.mjs"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "test:package": {
      "dependsOn": ["build"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "reports/tests.json"]
    },
    "@toolgrain/protocol#test:coverage": {
      "outputs": ["reports/tests.json"],
      "dependsOn": ["build"]
    },
    "test:examples": {
      "dependsOn": ["^build"],
      "outputs": ["reports/tests.json"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/test-http-example.mjs"
      ]
    },
    "test:size": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
