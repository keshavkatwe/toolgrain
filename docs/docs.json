  },
  "footer": {
    "links": [
      {
        "header": "Project",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/keshavkatwe/toolgrain"
          },
          {
            "label": "npm packages",
            "href": "https://www.npmjs.com/org/toolgrain"
          },
          {
            "label": "Releases",
            "href": "https://github.com/keshavkatwe/toolgrain/releases"
          }
        ]
      },
      {
        "header": "Community",
        "items": [
          {
            "label": "Report an issue",
            "href": "https://github.com/keshavkatwe/toolgrain/issues"
          },
          {
            "label": "Contributing",
            "href": "/project/contributing"
          },
          {
            "label": "Security",
            "href": "https://github.com/keshavkatwe/toolgrain/blob/main/.github/SECURITY.md"
          }
        ]
      }
    ],
    "socials": {
      "github": "https://github.com/keshavkatwe/toolgrain"
    }
  }
}
