{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Toolgrain",
  "colors": {
    "primary": "#657018",
    "light": "#E4EE85",
    "dark": "#657018"
  },
  "favicon": {
    "light": "/assets/favicon/light.svg",
    "dark": "/assets/favicon/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "npm packages",
          "href": "https://www.npmjs.com/org/toolgrain",
          "icon": "box"
        },
        {
          "anchor": "Examples",
          "href": "https://github.com/keshavkatwe/toolgrain/tree/main/apps",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/assets/logo/light.svg",
    "dark": "/assets/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/keshavkatwe/toolgrain/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/keshavkatwe/toolgrain"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Project",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/keshavkatwe/toolgrain"
          },
          {
            "label": "npm packages",
            "href": "https://www.npmjs.com/org/toolgrain"
          },
          {
            "label": "Releases",
            "href": "https://github.com/keshavkatwe/toolgrain/releases"
          }
        ]
      },
      {
        "header": "Community",
        "items": [
          {
            "label": "Report an issue",
            "href": "https://github.com/keshavkatwe/toolgrain/issues"
          },
          {
            "label": "Contributing",
            "href": "https://github.com/keshavkatwe/toolgrain/blob/main/.github/CONTRIBUTING.md"
          },
          {
            "label": "Security",
            "href": "https://github.com/keshavkatwe/toolgrain/blob/main/.github/SECURITY.md"
          }
        ]
      }
    ],
    "socials": {
      "github": "https://github.com/keshavkatwe/toolgrain"
    }
  }
}
