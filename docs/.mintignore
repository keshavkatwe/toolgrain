# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Markdown forwarding pages preserve GitHub guide URLs; MDX is the site source.
# Also exclude contributor instructions, READMEs, and asset provenance notes.
*.md

# Preserve third-party notices in the repository without making them site pages.
notices/
