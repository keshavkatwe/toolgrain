{
  "name": "toolgrain",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "test:package": "turbo run test:package test:clean-install",
    "test:clean-install": "node packages/repo-tools/src/cli.mjs clean-install",
    "test:coverage": "turbo run test:coverage",
    "test:examples": "turbo run test:examples",
    "test:size": "turbo run test:size --filter='./packages/*' --continue=dependencies-successful",
    "test:audit": "bun packages/repo-tools/src/cli.mjs audit",
    "test:ci": "bun run --cwd packages/repo-tools test:ci",
    "test:docs": "bun packages/repo-tools/src/cli.mjs docs",
    "release:check": "node packages/repo-tools/src/cli.mjs release check",
    "verify:inspector": "node packages/repo-tools/src/cli.mjs verify-inspector",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && node packages/repo-tools/src/cli.mjs release sync-lock"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-v8": "5.0.4",
    "turbo": "2.11.8"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14"
}
