{
  "name": "@toolgrain/mcp",
  "version": "0.1.1",
  "description": "Define reusable, typed MCP tools and servers with Zod validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavkatwe/toolgrain.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/keshavkatwe/toolgrain/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/keshavkatwe/toolgrain/issues"
  },
  "keywords": [
    "toolgrain",
    "mcp",
    "model-context-protocol",
    "typescript",
    "zod",
    "tools"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src/**/*.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "toolgrain-repo mcp-compat && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run --coverage",
    "test:size": "toolgrain-repo size"
  },
  "peerDependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "zod": "4.6.7",
    "@toolgrain/repo-tools": "workspace:*"
  },
  "dependencies": {
    "@toolgrain/protocol": "workspace:*"
  },
  "engines": {
    "node": "^24.20.0",
    "bun": ">=1.4.4 <2"
  }
}
