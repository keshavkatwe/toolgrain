{
  "name": "@toolgrain/clerk",
  "version": "0.1.1",
  "description": "Clerk OAuth access-token authorization for Toolgrain MCP servers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavkatwe/toolgrain.git",
    "directory": "packages/clerk"
  },
  "homepage": "https://github.com/keshavkatwe/toolgrain/tree/main/packages/clerk#readme",
  "bugs": {
    "url": "https://github.com/keshavkatwe/toolgrain/issues"
  },
  "keywords": [
    "toolgrain",
    "mcp",
    "model-context-protocol",
    "clerk",
    "oauth",
    "authorization"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && toolgrain-repo mcp-compat && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run --coverage",
    "test:size": "toolgrain-repo size"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0",
    "zod": "4.6.7",
    "@toolgrain/repo-tools": "workspace:*"
  },
  "dependencies": {
    "@toolgrain/mcp": "workspace:*",
    "@clerk/backend": "3.26.0",
    "@clerk/shared": "4.41.0",
    "jose": "6.2.13",
    "@toolgrain/jwt": "workspace:*"
  },
  "engines": {
    "node": "^24.20.0",
    "bun": ">=1.4.4 <2"
  }
}
