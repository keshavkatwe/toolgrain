{
  "name": "@toolgrain/protocol",
  "version": "0.1.2",
  "description": "Pinned MCP wire types, protocol versions, and upstream provenance for Toolgrain.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavkatwe/toolgrain.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://toolgrain.mintlify.site/reference/protocol",
  "bugs": {
    "url": "https://github.com/keshavkatwe/toolgrain/issues"
  },
  "keywords": [
    "toolgrain",
    "mcp",
    "model-context-protocol",
    "protocol",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./2025-06-18": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/copy-vendor.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && tsc -p smoke/tsconfig.json && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run",
    "test:size": "toolgrain-repo size"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0",
    "@toolgrain/repo-tools": "workspace:*"
  },
  "engines": {
    "node": "^24.20.0",
    "bun": ">=1.4.4 <2"
  }
}
