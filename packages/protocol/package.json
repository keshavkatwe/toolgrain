{
  "name": "@toolgrain/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./2025-06-18": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/copy-vendor.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && tsc -p smoke/tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0"
  }
}
