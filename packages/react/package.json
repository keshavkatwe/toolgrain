{
  "name": "@toolgrain/react",
  "version": "0.3.0-alpha.2",
  "description": "Native, typed React widgets for MCP Apps hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavkatwe/toolgrain.git",
    "directory": "packages/react"
  },
  "homepage": "https://toolgrain.mintlify.site/mcp-apps/react",
  "bugs": {
    "url": "https://github.com/keshavkatwe/toolgrain/issues"
  },
  "keywords": [
    "toolgrain",
    "mcp",
    "react",
    "mcp-apps"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && toolgrain-repo mcp-compat && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run --coverage",
    "test:size": "toolgrain-repo size"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0",
    "zod": "4.6.7",
    "@toolgrain/repo-tools": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0"
  },
  "dependencies": {
    "@toolgrain/mcp": "workspace:*",
    "@toolgrain/protocol": "workspace:*"
  },
  "engines": {
    "node": "^24.20.0",
    "bun": ">=1.4.4 <2"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "zod": "^4.6.6"
  }
}
