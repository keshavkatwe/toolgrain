{
  "name": "@toolgrain/http",
  "version": "0.1.0",
  "description": "Streamable HTTP handlers for Toolgrain MCP servers using Web Request and Response.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavkatwe/toolgrain.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/keshavkatwe/toolgrain/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/keshavkatwe/toolgrain/issues"
  },
  "keywords": [
    "toolgrain",
    "mcp",
    "model-context-protocol",
    "http",
    "streamable-http"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && tsc -p smoke/tsconfig.json && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run --coverage",
    "test:size": "toolgrain-repo size"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0",
    "zod": "4.6.7",
    "@toolgrain/repo-tools": "workspace:*"
  },
  "dependencies": {
    "@toolgrain/mcp": "workspace:*",
    "@toolgrain/protocol": "workspace:*"
  },
  "engines": {
    "node": "^24.20.0",
    "bun": ">=1.4.4 <2"
  }
}
