{
  "name": "@toolgrain/http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node smoke/runtime.mjs && tsc -p smoke/tsconfig.json && toolgrain-repo exports",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test:coverage": "vitest run --coverage",
    "test:size": "toolgrain-repo size"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "@types/node": "24.10.0",
    "zod": "4.6.7",
    "@toolgrain/repo-tools": "workspace:*"
  },
  "dependencies": {
    "@toolgrain/mcp": "workspace:*",
    "@toolgrain/protocol": "workspace:*"
  }
}
